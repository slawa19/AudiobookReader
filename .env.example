# Образец настроек рабочего окружения. Скопируйте в .env; .env в git не попадает.
# В самом приложении ключ вводится на экране настроек и хранится в защищённом хранилище Android — не здесь.

# Ключ Google Gemini API (Google AI Studio → Get API key) для платных замеров из рабочего окружения.
# Любой платный вызов — только с согласия владельца.
GEMINI_API_KEY=
# Базовый адрес Gemini API.
GEMINI_API_BASE=https://generativelanguage.googleapis.com

# Параметры подписи APK: синтаксис Bash, значения в одинарных кавычках.
# Постоянный ключ хранится вне репозитория; скрипты его не создают.
# Абсолютный путь Linux/WSL, например /mnt/c/Users/имя/keys/audiobook-reader.jks.
ANDROID_KEYSTORE_PATH=''
ANDROID_KEYSTORE_PASSWORD=''
ANDROID_KEY_ALIAS=''
ANDROID_KEY_PASSWORD=''
