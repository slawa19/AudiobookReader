# Sample settings for the working environment. Copy to .env; .env is not committed to git.
# In the app itself the key is entered on the settings screen and kept in Android secure storage, not here.

# Google Gemini API key (Google AI Studio → Get API key) for paid measurements from the working environment.
# Any paid call only with the owner's consent.
GEMINI_API_KEY=
# Gemini API base URL.
GEMINI_API_BASE=https://generativelanguage.googleapis.com

# APK signing parameters: Bash syntax, values in single quotes.
# The permanent key is kept outside the repository; the scripts do not create it.
# The release workflow (.github/workflows/release.yml) does not use .env: it passes the same four variables from
# GitHub Secrets (docs/RELEASING.md). When all four are already set in the environment, build-apk.sh ignores .env.
# An absolute Linux/WSL path, for example /mnt/c/Users/name/keys/audiobook-reader.jks.
ANDROID_KEYSTORE_PATH=''
ANDROID_KEYSTORE_PASSWORD=''
ANDROID_KEY_ALIAS=''
ANDROID_KEY_PASSWORD=''
