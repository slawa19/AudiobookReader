root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kt,kts,gradle,py,sh}]
indent_size = 4

[*.{cmd,bat}]
end_of_line = crlf

# License texts are kept verbatim (see .gitattributes).
[{NOTICES,assets/fonts/*-OFL.txt}]
trim_trailing_whitespace = false
